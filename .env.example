# =============================================================================
# InfrGate — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://infrgate:infrgate@localhost:5432/infrgate

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Provider Keys ------------------------------------------------------------
# Required: Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Admin Authentication -----------------------------------------------------
# Secret key for admin API access. Generate a strong random string.
ADMIN_API_KEY=your-admin-api-key-here

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Rate Limiting (defaults) ------------------------------------------------
DEFAULT_RPM=60
DEFAULT_TPM=100000

# --- BOT Chain / Web3 --------------------------------------------------------
# Contract address of InfrgateSubscription.sol on BOT Chain Mainnet
BOTCHAIN_CONTRACT_ADDRESS=
# RPC endpoint for BOT Chain mainnet
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# Official USDT token address on BOT Chain
USDT_CONTRACT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
# Block to start scanning events from (set to deployment block number)
BOTCHAIN_START_BLOCK=0
# Number of block confirmations before processing events
BOTCHAIN_CONFIRMATIONS=3
# Shared secret for chain listener → gateway internal webhook auth
WEB3_PROVISION_SECRET=your-strong-random-secret-here

# --- Smart Contract Deployment (Hardhat) -------------------------------------
# Only required when running `npx hardhat deploy` in the `contracts/` folder
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
EXPLORER_API_KEY=your-botchain-explorer-api-key
